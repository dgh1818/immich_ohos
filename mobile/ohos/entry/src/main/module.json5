{
  module: {
    name: "entry",
    type: "entry",
    description: "$string:module_desc",
    mainElement: "EntryAbility",
    deviceTypes: ["phone", "tablet"],

    deliveryWithInstall: true,
    installationFree: false,
    pages: "$profile:main_pages",
    abilities: [
      {
        name: "EntryAbility",
        srcEntry: "./ets/entryability/EntryAbility.ets",
        description: "$string:EntryAbility_desc",
        icon: "$media:start_icon",
        label: "$string:EntryAbility_label",
        startWindowIcon: "$media:app_icon",
        startWindowBackground: "$color:start_window_background",
        "orientation": "auto_rotation_restricted",
        exported: true,
        skills: [
          {
            entities: ["entity.system.home"],
            actions: [
              "action.system.home",
              "ohos.want.action.sendData",
            ],
            uris: [
              {
                scheme: "file",
                utd: "general.image",
                maxFileSupported: 50,
              },
              {
                scheme: "file",
                utd: "general.video",
                maxFileSupported: 50,
              },
            ],
          },
        ],
        "backgroundModes": [
          // 长时任务类型的配置项
          "dataTransfer",
        ]
      },
      {
        name: "RandomConfigureAbility",
        srcEntry: "./ets/plugins/widget/configure/RandomConfigureAbility.ets",
        description: "Immich widget configuration",
        icon: "$media:start_icon",
        label: "$string:EntryAbility_label",
        startWindowIcon: "$media:app_icon",
        startWindowBackground: "$color:start_window_background",
        exported: true
      },

    ],
    "extensionAbilities": [
//      {
//        "name": "ContentObserverWorkerTask",
//        "srcEntry": "./ets/workers/ContentObserverWorkScheduler.ets",
//        "type": "workScheduler"
//      }ContentObserverWorkScheduler
      {
        "name": "RandomReceiver",
        "srcEntry": "./ets/plugins/widget/RandomReceiver.ets",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config_random"
          }
        ]
      },
      {
        "name": "MemoryReceiver",
        "srcEntry": "./ets/plugins/widget/MemoryReceiver.ets",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config_memories"
          }
        ]
      },
      {
        "name": "MediaObserverScheduler",
        "srcEntry": "./ets/WorkSchedulerExtension/MediaObserverScheduler.ets",
        "type": "workScheduler"
      },
      {
        "name": "BackgroundWorker",
        "srcEntry": "./ets/WorkSchedulerExtension/BackgroundWorker.ets",
        "type": "workScheduler"
      },
      {
        "name": "PeriodicWorker",
        "srcEntry": "./ets/WorkSchedulerExtension/PeriodicWorker.ets",
        "type": "workScheduler"
      },
    ],
    requestPermissions: [
      {
        "name": "ohos.permission.ACCESS_BIOMETRIC",
        "reason": "$string:secure_desc",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      { name: "ohos.permission.INTERNET" },
      { name: "ohos.permission.VIBRATE" },
      {
        name: "ohos.permission.READ_IMAGEVIDEO",
        reason: "$string:backup_desc",
        usedScene: {
          when: "always",
        },
      },
      {
        name: "ohos.permission.MEDIA_LOCATION",
        reason: "$string:backup_desc",
        usedScene: {
          when: "always",
        },
      },
      {
        name: "ohos.permission.WRITE_IMAGEVIDEO",
        reason: "$string:backup_desc",
        usedScene: {
          when: "always",
        },
      },
      {"name" :  "ohos.permission.GET_WIFI_INFO",
        reason: "$string:WIFI_INFO_desc",
        usedScene: {
          when: "always",
        }
      },
      {
        name: "ohos.permission.LOCATION",
        reason: "$string:location_desc",
        usedScene: {
          when: "always",
        },
      },
      {
        name: "ohos.permission.APPROXIMATELY_LOCATION",
        reason: "$string:location_desc",
        usedScene: {
          when: "always",
        },
      },
      {
        name: "ohos.permission.KEEP_BACKGROUND_RUNNING",
        reason: "$string:backup_desc",
        usedScene: {
          when: "always",
        },
      },





      //      },
      //      {
      //        name: "ohos.permission.SYSTEM_FLOAT_WINDOW",
      //        reason: "$string:video_play",
      //        usedScene: {
      //          when: "always",
      //        },
      //      },
    ],
    metadata: [
      {
        name: "client_id",
        value: "6917569592630582305", // 配置为获取的Client ID
      },
    ],
  },
}
