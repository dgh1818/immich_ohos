{
  "apiType": 'stageMode',
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "abiFilters": [
        "arm64-v8a"
      ],
      "arguments": "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
    },
    "nativeLib": {
      "filter": {
        "excludes": [
          "**/x86_64/*.so"
        ]
      }
    },
    "sourceOption": {
      "workers": [
        //上架屏蔽
        "./src/main/ets/workers/BackupWorker.ets"
      ]
    },
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    },
  ]
}
