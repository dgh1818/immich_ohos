{
  "apiType": 'stageMode',
  "buildOption": {
    "externalNativeOptions": {
      "abiFilters": [
        "arm64-v8a"
      ],
      "arguments": "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
    },
    "sourceOption": {
      "workers": [
        './src/main/ets/workers/ContentObserverWorker.ets',
        './src/main/ets/workers/BackupWorker.ets'
      ]
    },
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    },
  ]
}
